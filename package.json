{
  "name": "godseye-detroit-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP gateway combining God's Eye View and Detroit Pulse for a claude.ai custom connector",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "dev": "npm run build && node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run typecheck && vitest run && node scripts/audit.mjs",
    "test:unit": "vitest run",
    "smoke:live": "npm run build && node dist/scripts/smoke-live.js",
    "devices": "node dist/scripts/devices.js",
    "hash-password": "node dist/scripts/hash-password.js",
    "backup": "node dist/scripts/backup-db.js",
    "rail:build": "node scripts/build-rail-data.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "8.20.0",
    "better-sqlite3": "13.1.1",
    "express": "5.3.0",
    "flatbush": "4.7.0",
    "jose": "6.2.17",
    "minisearch": "7.2.0",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "~10.14.0",
    "prettier": "~3.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.0",
    "vitest": "~5.1.0"
  }
}
