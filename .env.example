# godseye-detroit-connector gateway configuration.
# Copy to .env (dev) or deploy/secrets/gateway.env (docker), then `chmod 600` it.
# Never commit the real file. Every value below is optional unless marked REQUIRED.

# --- Mode -----------------------------------------------------------------
# development (default for plain `node`), production (fail-closed; docker), test
GATEWAY_MODE=development
# PUBLIC listener (Cloudflare Tunnel only): /mcp, metadata, token/register/revoke, /api/location, /healthz
# Production (compose sets it): the sidecar's compose-network address 172.30.77.20. Production
# refuses 0.0.0.0 and 127.0.0.1: Tailscale's userspace netstack forwards tailnet connections there.
HOST=127.0.0.1
PORT=7700
# The public origin claude.ai uses. The MCP resource is PUBLIC_ORIGIN + "/mcp".
PUBLIC_ORIGIN=https://godseye.gamachecloud.com
# Peers whose CF-Connecting-IP header is trusted on the PUBLIC listener (cloudflared only). Comma
# list. Production (compose): 172.30.77.10; loopback is refused there. The private and UI
# listeners never trust a forwarding header.
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1
# DATA_DIR=./data
LOG_LEVEL=info

# --- Private (tailnet-only) listener: /oauth/authorize, consent, /oauth/admin, /locate ------
# Production (compose): 127.0.0.2 (a loopback alias the netstack never dials; 127.0.0.1 and
# 0.0.0.0 are refused). Dev with host `tailscale serve`: 127.0.0.1.
PRIVATE_HOST=127.0.0.1
PRIVATE_PORT=7702
# The URL you open on tailnet devices (tailscale serve :443). REQUIRED in production, must be https.
PRIVATE_ORIGIN=
# --- UI listener (tailnet-only, its own origin): the GEV globe at /, /pulse ------------------
# Defaults: UI_HOST=$PRIVATE_HOST, UI_ORIGIN=$PRIVATE_ORIGIN on port 8443 (tailscale serve :8443).
# UI_ORIGIN must differ from PRIVATE_ORIGIN.
# UI_HOST=
UI_PORT=7703
# UI_ORIGIN=
# Defaults: AUTHORIZATION_ENDPOINT=$PRIVATE_ORIGIN/oauth/authorize, LINK_ORIGIN=$UI_ORIGIN
# AUTHORIZATION_ENDPOINT=
# LINK_ORIGIN=
# FALLBACK only if claude.ai rejects a cross-host authorization_endpoint: serve /oauth/authorize
# on the PUBLIC listener behind password+TOTP. Off by default. See docs/tailscale-setup.md.
PUBLIC_AUTHORIZE_FALLBACK=off

# --- Login -------------------------------------------------------------------------
# auto = tailscale when OWNER_TAILSCALE_LOGIN is set, else password+TOTP (dev/test only).
LOGIN_PROVIDER=auto
# Your Tailscale login name as tailscale serve reports it (Tailscale-User-Login), REQUIRED in production.
OWNER_TAILSCALE_LOGIN=
# Peers allowed to assert Tailscale-User-Login on the private and UI listeners (tailscale serve
# connects from 127.0.0.1). Must be loopback in production.
TAILSCALE_TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1
# Dev/test login (and the opt-in public fallback). Generate with: npm run hash-password -- --totp
GATEWAY_PASSWORD_HASH=
GATEWAY_TOTP_SECRET=
# HMAC key for CSRF tokens and session cookies (32+ random bytes, base64).
# If empty, one is generated and stored in the database.
SESSION_SECRET=
# Step-up second factor (TOTP) on consent approval and /oauth/admin: on by default; fails closed
# until enrolled (`npm run stepup -- enroll`, docker: docker exec -it godseye-gateway node dist/scripts/stepup.js enroll).
STEPUP_TOTP=on
STEPUP_WINDOW_S=600
# 32 random bytes (base64url) that encrypt the TOTP secret at rest. REQUIRED in production.
# Generate: npm run stepup -- keygen   (or: openssl rand -base64 32)
STEPUP_KEY=

# --- God's Eye View -----------------------------------------------------------
# GEV_ROOT=../gods-eye-view   (default: the clone next to this repo)
GEV_URL=http://127.0.0.1:7701
GEV_MCP_ENABLED=true
# Production (compose): tcp://gev-mcp:7704, the GEV MCP child in its own container. Unset: spawn locally.
# GEV_CHILD_URL=
# Licensing switches (see docs/security.md and README "Tool policy"):
# OpenSky needs a written licence for automated use; keep false until you have one.
ALLOW_OPENSKY_TOOLS=false
# OSM-mapped licence plate reader locations.
ALLOW_ALPR_TOOLS=false
# Place-name arguments need NOMINATIM_URL configured in GEV. Off = pass lat/lon only.
GEV_PLACE_NAMES=false
# Extra deny list (comma separated tool names).
TOOL_DENYLIST=
# bucket=N/(s|m|h|d) comma list. "nominatim" is the bucket for place-name lookups.
TOOL_RATE_LIMITS=get_traffic_flow=20/h,get_traffic_flow=150/d,plan_route=30/h,get_cctv_snapshot=60/h,nominatim=30/h,get_recent_imagery=20/h,get_regional_brief=30/h
TOOL_TIMEOUT_MS=110000
MAX_CONCURRENT_TOOL_CALLS=4
MAX_RESULT_CHARS=100000
IMAGE_MAX_DIM=768
IMAGE_MAX_BASE64_CHARS=60000
MAX_IMAGES_PER_RESULT=1

# --- Detroit Pulse (future) ------------------------------------------------
PULSE_URL=http://127.0.0.1:7710
PULSE_API_TOKEN=
PULSE_TIMEOUT_MS=5000
# Directory holding a built Pulse UI to serve at /pulse (optional).
PULSE_STATIC_DIR=

# --- OAuth ------------------------------------------------------------------
ACCESS_TOKEN_TTL_S=3600
REFRESH_TOKEN_TTL_S=7776000
AUTH_CODE_TTL_S=60
# 0 = any reuse of a rotated refresh token revokes the whole family.
REFRESH_REUSE_GRACE_S=0
CIMD_ALLOWED_CLIENT_IDS=https://claude.ai/oauth/mcp-oauth-client-metadata,https://claude.ai/oauth/claude-code-client-metadata
DCR_ENABLED=true
DCR_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
LOOPBACK_REDIRECT_URIS=http://localhost/callback,http://127.0.0.1/callback

# --- Location -----------------------------------------------------------------
LOCATION_RETENTION_HOURS=24
LOCATION_STALE_MINUTES=10
# Explicit-point tool results say how far the phone is from that point when its fix is this recent.
LOCATION_PROXIMITY_MINUTES=30

# --- Aviation (flights_near, aircraft_lookup) --------------------------------------
# No keys. Live aircraft from adsb.fi (personal, non-commercial use only), adsb.lol as fallback
# (ODbL 1.0); owners from a local copy of the FAA Releasable Aircraft Database.
# Private registrants (individual, co-owned, partnership): private_hidden = "private individual"
# plus city/state; type_only = the label alone; full = the name in single-aircraft lookups (names
# are only kept in the copy with full). Street and ZIP are never kept or shown.
AIRCRAFT_OWNER_DISCLOSURE=private_hidden
# Withhold the owner name of LADD-flagged aircraft unless the registrant is a government.
AIRCRAFT_LADD_WITHHOLD=true
# Daily FAA registry download (about 06:15 UTC, If-Modified-Since). Copy: AIRCRAFT_REGISTRY_DIR
# (default DATA_DIR/aviation). Manual run: node dist/scripts/aircraft-registry-sync.js
AIRCRAFT_REGISTRY_SYNC=true
# AIRCRAFT_REGISTRY_DIR=
# AIRCRAFT_REGISTRY_URL=https://registry.faa.gov/database/ReleasableAircraft.zip
# adsb.lol (fallback) calls per rolling 24 h; its keyless quota is per IP and shared with GEV.
ADSBLOL_DAILY_MAX=100
# Default quotas for buckets TOOL_RATE_LIMITS does not set.
AVIATION_RATE_LIMITS=flights_near=60/h,flights_near=600/d,aircraft_lookup=120/h

# ---- weather ----
# weather_alerts, weather_forecast (NWS) and water_levels_near (NOAA CO-OPS, USGS, NWS NWPS) need
# no key. They send the point (4 decimals) and a generic User-Agent, nothing else.
# USGS Water Data key (free: https://api.waterdata.usgs.gov/signup). Empty = the shared DEMO_KEY,
# whose limits are low (USGS answers are cached 10 min to stay under them).
USGS_API_KEY=
# EPA AirNow key (free account at https://docs.airnowapi.org). Empty = air_quality is OFF.
# AirNow's Data Exchange Guidelines apply: data is preliminary, credit the agency and AirNow,
# never alter values; tell dmc@airnowtech.org that a personal, non-commercial assistant uses it.
AIRNOW_API_KEY=
WEATHER_HTTP_TIMEOUT_MS=12000
# Default quotas for these tools; a TOOL_RATE_LIMITS entry for the same bucket replaces one.
WEATHER_TOOL_RATE_LIMITS=weather_alerts=120/h,weather_forecast=60/h,water_levels_near=20/h,air_quality=30/h
# ---- end weather ----

# --- Roads and places (road_closures, geocode_place, route_avoiding_closures, ----------
# --- mdot_camera_link, border_wait_times; src/extra/roads) ---------------------------
# Keyless sources work out of the box. A source that needs a key stays OFF, and each result
# says which variable to set, until the key is here (deploy/secrets/gateway.env in docker).
# Generic User-Agent for every outbound request. Keep personal data (names, emails) out of it.
ROADS_USER_AGENT=godseye-connector/0.1 (personal non-commercial MCP gateway)
ROADS_FETCH_TIMEOUT_MS=12000
# Default per-tool quotas; a bucket also named in TOOL_RATE_LIMITS keeps that value.
ROADS_TOOL_RATE_LIMITS=road_closures=60/h,geocode_place=60/h,route_avoiding_closures=30/h,mdot_camera_link=60/h,border_wait_times=60/h
# City of Detroit right-of-way permits (keyless open data).
DETROIT_ROW_ENABLED=true
# TomTom Traffic Incident Details: the same key GEV uses for traffic flow, AND the owner's
# licence switch (TomTom's free tier is "Evaluation Use"; see docs/security.md). Never cached;
# hard-capped per day (counted on disk, so restarts don't reset it).
TOMTOM_API_KEY=
ALLOW_TOMTOM_INCIDENTS=false
TOMTOM_INCIDENTS_DAILY_MAX=60
# MDOT RIDE (MiLogin for Business subscription), sent in the api_key header. Polled at most
# every MDOT_RIDE_CACHE_S (>= 300). The Traffic Events dataset name is unverified (the RIDE docs
# need a login): change MDOT_RIDE_EVENTS_DATASET if results say it was not found.
MDOT_RIDE_API_KEY=
# MDOT_RIDE_URL=https://mdotridedata.state.mi.us/api/v1/organization/michigan_department_of_transportation/dataset
# MDOT_RIDE_WORK_ZONES_DATASET=work_zone_information
# MDOT_RIDE_EVENTS_DATASET=traffic_events
# MDOT_RIDE_LIMIT=200
MDOT_RIDE_CACHE_S=300
# Ontario 511 developer key (Windsor/Essex events and construction). At most 10 calls/60 s.
ONTARIO_511_API_KEY=
ONTARIO_511_CACHE_S=180
# Geocoding chain: Census (addresses) -> Photon -> public Nominatim (last resort, <= 1 req/s).
# GEOCODER_CENSUS_URL=https://geocoding.geo.census.gov/geocoder
# GEOCODER_PHOTON_URL=https://photon.komoot.io
# GEOCODER_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_NOMINATIM_DAILY_MAX=50
# A self-hosted Overpass interpreter (…/api/interpreter) for intersections ("I-94 and M-10").
# Never a public instance (see docs/security.md). Unset = intersections are not supported.
OVERPASS_URL=
# Routing (FOSSGIS asks that the URL be configurable, not hard-coded). <= 1 req/s.
VALHALLA_URL=https://valhalla1.openstreetmap.de
# MIDRIVE_MAP_URL=https://mdotjboss.state.mi.us/MiDrive/map
# CBP_BWT_URL=https://bwt.cbp.gov/api/bwtnew
# CBSA_BWT_URL=https://www.cbsa-asfc.gc.ca/bwt-taf/bwt-eng.csv

# --- Civic tools (dpd_calls_near, transit_vehicles_near, local_headlines) ------
# dpd_calls_near (City of Detroit open data) and local_headlines (GDELT) need no key.
# Free Swiftly real-time API key for SMART buses (request: https://goswift.ly/realtime-api-key).
# Sent only to api.goswift.ly as the Authorization header. Empty = transit_vehicles_near is off.
SWIFTLY_API_KEY=
# Read SMART's public static GTFS (route names, headsigns), in memory, at most daily.
SMART_STATIC_GTFS=true
# Default quotas for these tools; a TOOL_RATE_LIMITS entry for the same bucket replaces one.
CIVIC_TOOL_RATE_LIMITS=dpd_calls_near=60/h,transit_vehicles_near=120/h,local_headlines=30/h,local_headlines=200/d

# --- Radio (radio_stations_near; src/extra/radio) ----------------------------------
# The public Radio Browser directory (keyless; directory data is public domain, PDDL). It is
# asked about a 0.05 degree grid point with the radius plus 6 km, never the exact position, and
# answers are cached 30 min. No stream is ever fetched.
# Default quotas; a TOOL_RATE_LIMITS entry for the same bucket replaces one.
RADIO_TOOL_RATE_LIMITS=radio_stations_near=60/h,radio_stations_near=300/d
