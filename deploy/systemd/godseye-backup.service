# Nightly SQLite backup (see godseye-backup.timer). Docker mode by default; for dev mode use
#   ExecStart=/home/nathangamache/.nvm/versions/node/v24.22.3/bin/node dist/scripts/backup-db.js
# with WorkingDirectory=/home/nathangamache/projects/godseye/godseye-detroit-connector
[Unit]
Description=Back up the godseye gateway database

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec godseye-gateway node dist/scripts/backup-db.js
Nice=19
IOSchedulingClass=idle
